[Unit]
Description=Reconcile AirlineManager Paperclip issues and GitHub PRs
After=network-online.target docker.service airline-delivery-token.service

[Service]
Type=oneshot
User=ubuntu
StateDirectory=airline-delivery
ExecCondition=/usr/bin/test -s /opt/airline-delivery/token/token
ExecStart=/usr/bin/python3 -B /opt/airline-delivery/reconcile.py --config /etc/airline-delivery/controller.json --state /var/lib/airline-delivery/state.json --mode merge
TimeoutStartSec=5min
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
UMask=0077
